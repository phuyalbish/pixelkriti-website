{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixelkriti",
  "compatibility_date": "2026-07-09",

  // A minimal script sits in front of the assets purely to 301 the
  // workers.dev alias onto pixelkriti.com. `run_worker_first` is required:
  // without it, requests that match an asset never reach the script, so the
  // redirect would only fire on misses.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,

    // Routing is client-side for anything not prerendered. Without this, a
    // hard refresh on an unprerendered deep path would 404 — every unmatched
    // request must fall back to index.html.
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  },

  // Enquiries, dashboard accounts and sessions. APAC-primary: the people
  // reading this dashboard and most of the people filling the form are in
  // Nepal, and D1 reads are fastest near the primary.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixelkriti-enquiries",
      "database_id": "36d9b2de-5ff2-44f8-919c-7f1b941476f4"
    }
  ],

  // NOT secrets - these are addresses, and they land in email headers every
  // recipient can read anyway. The one secret is the Resend API key, set once
  // and never written down:
  //   npx wrangler secret put RESEND_API_KEY
  "vars": {
    // Gmail sends as the authenticated mailbox, so this must BE that mailbox
    // (or an alias verified in Gmail under Settings -> Accounts -> "Send mail
    // as" - Google rewrites the From header back to the real account
    // otherwise, and the alias achieves nothing).
    //
    // info@pixelkriti.com would be the better address to reach a client from,
    // and it is what Resend was set up to use - but that needs DNS on
    // pixelkriti.com which is not done, so it sends nothing at all today. A
    // working notification from a gmail.com address beats a perfect one that
    // never arrives. Revisit once the domain is verified.
    "GMAIL_SENDER": "Pixel Kriti <pixelkriti@gmail.com>",

    // Where "you have a new enquiry" goes. Deliberately the gmail address and
    // not info@pixelkriti.com: that one is unverified for sending and
    // unconfirmed for receiving (see the TODO in src/data/site.js), so a
    // notification sent there might land nowhere and nobody would know.
    //
    // TODO: replace with the three real addresses, comma-separated
    // (amitesh@..., bishal@..., muzammil@...) once they exist.
    "NOTIFY_TO": "pixelkriti@gmail.com"
  }
}
