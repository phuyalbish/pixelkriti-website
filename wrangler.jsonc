{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pixelkriti",
  "compatibility_date": "2026-07-09",

  // Assets-only Worker: the site is fully static, so there is no `main` entry
  // point and no ASSETS binding (both are only valid alongside a Worker script).
  "assets": {
    "directory": "./dist",

    // Routing is client-side. Without this, a hard refresh or a shared link to
    // a deep path such as /work/logistics-analytics would 404, because no file
    // exists at that path — every unmatched request must fall back to index.html.
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
